---
import type { MarkdownHeading } from 'astro';
import type { TocEntry } from '@openuji/speculator';

import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import { getCaseStudies, type CaseStudy } from '@/lib/case-studies';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props as { study: CaseStudy };
const { Content } = study.post;
const headings =
  typeof study.post.getHeadings === 'function'
    ? (study.post.getHeadings() as MarkdownHeading[])
    : [];

function buildToc(headings: MarkdownHeading[]): TocEntry[] {
  const entries: TocEntry[] = [];
  let currentSection: TocEntry | undefined;

  for (const heading of headings) {
    if (heading.depth === 2) {
      currentSection = {
        id: heading.slug,
        text: heading.text,
        depth: 1,
        children: [],
      };
      entries.push(currentSection);
    } else if (heading.depth === 3) {
      const child: TocEntry = {
        id: heading.slug,
        text: heading.text,
        depth: 2,
        children: [],
      };

      if (currentSection) {
        currentSection.children?.push(child);
      } else {
        entries.push(child);
      }
    }
  }

  return entries;
}

const toc = buildToc(headings);
---

<CaseStudyLayout
  title={study.title}
  summary={study.summary}
  teaser={study.teaser}
  tags={study.tags}
  heroImage={study.heroImage}
  publishedAt={study.publishedAt}
  updatedAt={study.updatedAt}
  toc={toc}
>
  <Content />
</CaseStudyLayout>
